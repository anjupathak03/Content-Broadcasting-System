NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000

# Either use DATABASE_URL or the MYSQL* variables below.
DATABASE_URL=mysql://content_user:content_password@localhost:3306/content_broadcasting_system
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=content_broadcasting_system
MYSQLUSER=content_user
MYSQLPASSWORD=content_password
MYSQL_SSL=false

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Storage: local or s3. Local is the default and requires no cloud setup.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads/content
MAX_FILE_SIZE_MB=10

# S3 settings. Used only when STORAGE_DRIVER=s3.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_S3_BUCKET=
AWS_S3_PREFIX=content-broadcasting-system-content
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
AWS_S3_PUBLIC_BASE_URL=
AWS_S3_ACL=
AWS_S3_SIGNED_URLS=true
AWS_S3_SIGNED_URL_EXPIRES_SECONDS=900

DEFAULT_ROTATION_MINUTES=5
PUBLIC_RATE_LIMIT_PER_MINUTE=60

# Optional. Leave empty to disable Redis caching.
REDIS_URL=
LIVE_CACHE_TTL_SECONDS=15
